# Copy to .env (gitignored); Taskfile loads it automatically.
# Fine-grained PAT, read-only: Metadata, Contents, Issues, Pull requests,
# Dependabot alerts, Code scanning alerts, Secret scanning alerts.
# Optional when [auth.app] is configured.
GITHUB_TOKEN=
# Only with [auth.app] private_key_env = "GITHUB_APP_PRIVATE_KEY":
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# ...
# -----END RSA PRIVATE KEY-----"
RUST_LOG=info,server=debug,collector=debug
